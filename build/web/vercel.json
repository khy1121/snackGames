{
    "headers": [
        {
            "source": "/audio/(.*)\\.mp3",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "audio/mpeg"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/sfx/(.*)\\.mp3",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "audio/mpeg"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!audio/)(?!sfx/)(?!assets/)(?!icons/).*)",
            "destination": "/index.html"
        }
    ]
}