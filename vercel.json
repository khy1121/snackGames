{
  "buildCommand": "echo 'Using pre-built files' && cp -r web/audio build/web/audio 2>/dev/null; cp -r web/sfx build/web/sfx 2>/dev/null; echo 'Audio/SFX copied'",
  "outputDirectory": "build/web",
  "installCommand": "echo 'No install needed'",
  "headers": [
    {
      "source": "/audio/(.*)\\.mp3",
      "headers": [
        { "key": "Content-Type", "value": "audio/mpeg" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sfx/(.*)\\.mp3",
      "headers": [
        { "key": "Content-Type", "value": "audio/mpeg" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!audio/)(?!sfx/)(?!assets/)(?!icons/)(?!canvaskit/)(?!flutter).*)",
      "destination": "/index.html"
    }
  ]
}